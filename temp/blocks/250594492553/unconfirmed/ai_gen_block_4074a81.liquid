{% doc %}
  @prompt
    Large bold text filled with an image. Include a setting to control the background color.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .ai-image-text-{{ ai_gen_id }}__heading {
    margin: 0;
    font-family: {{ block.settings.heading_font.family }}, sans-serif;
    font-size: {{ block.settings.text_size }}px;
    line-height: 0.92;
    font-weight: 800;
    letter-spacing: -0.04em;
    text-align: {{ block.settings.alignment }};
    color: transparent;
    background-color: {{ block.settings.fallback_text_color }};
    {% if block.settings.image %}
      background-image: url('{{ block.settings.image | image_url: width: 2400 }}');
      background-size: {{ block.settings.image_fit }};
      background-position: center;
    {% endif %}
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    overflow-wrap: anywhere;
  }

  .ai-image-text-{{ ai_gen_id }}__placeholder {
    position: relative;
    min-height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ block.settings.fallback_text_color }};
  }

  .ai-image-text-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    max-width: 420px;
    height: 180px;
    opacity: 0.16;
  }

  .ai-image-text-{{ ai_gen_id }}__empty-state {
    position: absolute;
    bottom: 14px;
    left: 16px;
    right: 16px;
    margin: 0;
    color: {{ block.settings.background_color }};
    font-size: 13px;
    line-height: 1.4;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-image-text-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding }}px;
    }

    .ai-image-text-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.mobile_text_size }}px;
    }
  }
{% endstyle %}

<div class="ai-image-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.image %}
    <h2 class="ai-image-text-{{ ai_gen_id }}__heading">{{ block.settings.text | escape }}</h2>
  {% else %}
    <div class="ai-image-text-{{ ai_gen_id }}__placeholder">
      {{ 'image' | placeholder_svg_tag }}
      <p class="ai-image-text-{{ ai_gen_id }}__empty-state">Add an image to fill the text.</p>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Image-filled text",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Make a statement"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Text image"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font",
      "default": "acme_n4"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F3F3F3"
    },
    {
      "type": "color",
      "id": "fallback_text_color",
      "label": "Fallback text",
      "default": "#121212"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 40,
      "max": 220,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "label": "Mobile text size",
      "min": 32,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Mobile padding",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Image-filled text"
    }
  ],
  "tag": null,
  "class": "image-filled-text-block"
}
{% endschema %}