{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
  }

  .ai-editorial-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(260px, 0.85fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: center;
    padding: clamp(24px, 5vw, 72px);
  }

  .ai-editorial-{{ ai_gen_id }}__media {
    position: relative;
    min-height: 420px;
    overflow: hidden;
    background: #e9e7e2;
  }

  .ai-editorial-{{ ai_gen_id }}__media img,
  .ai-editorial-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 420px;
    object-fit: cover;
  }

  .ai-editorial-{{ ai_gen_id }}__placeholder {
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #68645e;
  }

  .ai-editorial-{{ ai_gen_id }}__label {
    position: absolute;
    top: 18px;
    left: 18px;
    padding: 7px 11px;
    background: {{ block.settings.label_background }};
    color: {{ block.settings.label_text_color }};
    font-size: 11px;
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
  }

  .ai-editorial-{{ ai_gen_id }}__content {
    max-width: 490px;
  }

  .ai-editorial-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 18px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .ai-editorial-{{ ai_gen_id }}__heading {
    margin: 0;
    font-size: clamp(36px, 5vw, 72px);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .ai-editorial-{{ ai_gen_id }}__body {
    margin: 28px 0 0;
    font-size: 16px;
    line-height: 1.65;
  }

  .ai-editorial-{{ ai_gen_id }}__body p {
    margin: 0 0 12px;
  }

  .ai-editorial-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 25px;
    padding: 13px 18px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .ai-editorial-{{ ai_gen_id }}__link:focus-visible {
    outline: 3px solid {{ block.settings.accent_color }};
    outline-offset: 3px;
  }

  .ai-editorial-{{ ai_gen_id }}__link span {
    font-size: 18px;
    line-height: 0;
  }

  .ai-editorial-{{ ai_gen_id }}__rule {
    width: 100%;
    height: 1px;
    margin-top: 34px;
    background: {{ block.settings.rule_color }};
  }

  .ai-editorial-{{ ai_gen_id }}__caption {
    margin-top: 12px;
    color: {{ block.settings.muted_color }};
    font-size: 12px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-{{ ai_gen_id }}__inner {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 24px 18px 32px;
    }

    .ai-editorial-{{ ai_gen_id }}__media,
    .ai-editorial-{{ ai_gen_id }}__placeholder,
    .ai-editorial-{{ ai_gen_id }}__media img,
    .ai-editorial-{{ ai_gen_id }}__placeholder svg {
      min-height: 300px;
    }

    .ai-editorial-{{ ai_gen_id }}__heading {
      font-size: clamp(40px, 13vw, 58px);
    }
  }
{% endstyle %}

<article class="ai-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-{{ ai_gen_id }}__inner">
    <div class="ai-editorial-{{ ai_gen_id }}__media">
      {% if block.settings.image %}
        <img src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% else %}
        <div class="ai-editorial-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
      {% if block.settings.image_label != blank %}
        <span class="ai-editorial-{{ ai_gen_id }}__label">{{ block.settings.image_label }}</span>
      {% endif %}
    </div>

    <div class="ai-editorial-{{ ai_gen_id }}__content">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="ai-editorial-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>
      {% if block.settings.body != blank %}
        <div class="ai-editorial-{{ ai_gen_id }}__body">{{ block.settings.body }}</div>
      {% endif %}
      {% if block.settings.button_label != blank and block.settings.button_link != blank %}
        <a class="ai-editorial-{{ ai_gen_id }}__link" href="{{ block.settings.button_link }}">
          {{ block.settings.button_label }} <span aria-hidden="true">→</span>
        </a>
      {% endif %}
      <div class="ai-editorial-{{ ai_gen_id }}__rule"></div>
      {% if block.settings.caption != blank %}
        <p class="ai-editorial-{{ ai_gen_id }}__caption">{{ block.settings.caption }}</p>
      {% endif %}
    </div>
  </div>
</article>

{% schema %}
{
  "name": "Editorial feature",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Feature image"
    },
    {
      "type": "text",
      "id": "image_label",
      "label": "Image label",
      "default": "The edit"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Winter journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The art of layering"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Thoughtful layers, considered textures, and timeless pieces made for the season ahead.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "textarea",
      "id": "caption",
      "label": "Caption",
      "default": "A considered wardrobe for colder days."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F3F3F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#6B3F2A"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "label_background",
      "label": "Label background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "label_text_color",
      "label": "Label text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "rule_color",
      "label": "Rule",
      "default": "#B8B5AE"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#5C5A55"
    }
  ],
  "presets": [
    {
      "name": "Editorial feature"
    }
  ],
  "tag": null,
  "class": "editorial-feature-block"
}
{% endschema %}