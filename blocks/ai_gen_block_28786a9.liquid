{% doc %}
  @prompt
    An interactive vertical timeline that highlights as the user scrolls
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-timeline-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;color:{{ block.settings.text_color }};background:{{ block.settings.background_color }};padding:{{ block.settings.section_padding }}px 24px}.ai-timeline__inner-{{ ai_gen_id }}{max-width:860px;margin:0 auto}.ai-timeline__heading-{{ ai_gen_id }}{margin:0 0 48px;font-family:{{ settings.type_header_font.family }},sans-serif;font-size:{{ block.settings.heading_size }}px;line-height:1.15;text-align:{{ block.settings.heading_alignment }};color:{{ block.settings.text_color }}}.ai-timeline__list-{{ ai_gen_id }}{position:relative;list-style:none;margin:0;padding:0}.ai-timeline__list-{{ ai_gen_id }}:before{content:'';position:absolute;top:10px;bottom:10px;left:18px;width:2px;background:{{ block.settings.line_color }}}.ai-timeline__item-{{ ai_gen_id }}{position:relative;display:grid;grid-template-columns:38px minmax(0,1fr);gap:24px;padding-bottom:48px}.ai-timeline__item-{{ ai_gen_id }}:last-child{padding-bottom:0}.ai-timeline__marker-{{ ai_gen_id }}{position:relative;z-index:1;width:38px;height:38px;display:flex;align-items:center;justify-content:center;border:2px solid {{ block.settings.line_color }};border-radius:50%;background:{{ block.settings.background_color }};color:{{ block.settings.muted_color }};font-size:13px;font-weight:700}.ai-timeline__content-{{ ai_gen_id }}{padding:2px 0 4px;opacity:.52}.ai-timeline__item-{{ ai_gen_id }}.is-active .ai-timeline__content-{{ ai_gen_id }}{opacity:1}.ai-timeline__item-{{ ai_gen_id }}.is-active .ai-timeline__marker-{{ ai_gen_id }}{background:{{ block.settings.accent_color }};border-color:{{ block.settings.accent_color }};color:{{ block.settings.accent_text_color }}}.ai-timeline__eyebrow-{{ ai_gen_id }}{display:block;margin-bottom:8px;color:{{ block.settings.accent_color }};font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.ai-timeline__title-{{ ai_gen_id }}{margin:0 0 10px;font-family:{{ settings.type_header_font.family }},sans-serif;font-size:{{ block.settings.item_title_size }}px;line-height:1.25;color:{{ block.settings.text_color }}}.ai-timeline__description-{{ ai_gen_id }}{margin:0;max-width:640px;color:{{ block.settings.text_color }};font-size:16px;line-height:1.6}@media screen and (max-width:749px){.ai-timeline-{{ ai_gen_id }}{padding-right:18px;padding-left:18px}.ai-timeline__heading-{{ ai_gen_id }}{margin-bottom:36px}.ai-timeline__item-{{ ai_gen_id }}{gap:16px;padding-bottom:36px}}{% endstyle %}
<scroll-timeline-{{ ai_gen_id }} class="ai-timeline-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-timeline__inner-{{ ai_gen_id }}">{% if block.settings.heading != blank %}<h2 class="ai-timeline__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}<ol class="ai-timeline__list-{{ ai_gen_id }}">{% for i in (1..5) %}{% assign title_key = 'item_' | append: i | append: '_title' %}{% assign eyebrow_key = 'item_' | append: i | append: '_eyebrow' %}{% assign description_key = 'item_' | append: i | append: '_description' %}{% assign item_title = block.settings[title_key] %}{% assign item_eyebrow = block.settings[eyebrow_key] %}{% assign item_description = block.settings[description_key] %}{% if item_title != blank or item_description != blank %}<li class="ai-timeline__item-{{ ai_gen_id }}{% if forloop.first %} is-active{% endif %}" data-timeline-item><span class="ai-timeline__marker-{{ ai_gen_id }}" aria-hidden="true">{{ i }}</span><div class="ai-timeline__content-{{ ai_gen_id }}">{% if item_eyebrow != blank %}<span class="ai-timeline__eyebrow-{{ ai_gen_id }}">{{ item_eyebrow | escape }}</span>{% endif %}{% if item_title != blank %}<h3 class="ai-timeline__title-{{ ai_gen_id }}">{{ item_title | escape }}</h3>{% endif %}{% if item_description != blank %}<p class="ai-timeline__description-{{ ai_gen_id }}">{{ item_description | escape | newline_to_br }}</p>{% endif %}</div></li>{% endif %}{% endfor %}</ol></div></scroll-timeline-{{ ai_gen_id }}>
<script>(function(){class ScrollTimeline{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.items=Array.from(this.querySelectorAll('[data-timeline-item]'));if(!this.items.length||!('IntersectionObserver' in window))return;this.observer=new IntersectionObserver((entries)=>{entries.forEach((entry)=>{if(entry.isIntersecting){this.items.forEach((item)=>item.classList.remove('is-active'));entry.target.classList.add('is-active')}})},{rootMargin:'-35% 0px -45% 0px',threshold:0});this.items.forEach((item)=>this.observer.observe(item))}disconnectedCallback(){if(this.observer)this.observer.disconnect()}}if(!customElements.get('scroll-timeline-{{ ai_gen_id }}'))customElements.define('scroll-timeline-{{ ai_gen_id }}',ScrollTimeline{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Scroll timeline","settings":[{"type":"text","id":"heading","label":"Heading","default":"Our journey"},{"type":"select","id":"heading_alignment","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"left"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"section_padding","label":"Section padding","min":20,"max":120,"step":10,"unit":"px","default":60},{"type":"range","id":"heading_size","label":"Heading size","min":24,"max":64,"step":4,"unit":"px","default":40},{"type":"range","id":"item_title_size","label":"Item title size","min":18,"max":36,"step":2,"unit":"px","default":26},{"type":"color","id":"background_color","label":"Background","default":"#FFFFFF"},{"type":"color","id":"text_color","label":"Text","default":"#121212"},{"type":"color","id":"accent_color","label":"Accent","default":"#334FB4"},{"type":"color","id":"accent_text_color","label":"Accent text","default":"#FFFFFF"},{"type":"color","id":"line_color","label":"Line","default":"#D9D9D9"},{"type":"color","id":"muted_color","label":"Muted text","default":"#555555"},{"type":"header","content":"Timeline items"},{"type":"text","id":"item_1_eyebrow","label":"Item 1 eyebrow","default":"Beginning"},{"type":"text","id":"item_1_title","label":"Item 1 title","default":"A thoughtful beginning"},{"type":"textarea","id":"item_1_description","label":"Item 1 description","default":"Share the first milestone in your story."},{"type":"text","id":"item_2_eyebrow","label":"Item 2 eyebrow","default":"Growing"},{"type":"text","id":"item_2_title","label":"Item 2 title","default":"Finding our direction"},{"type":"textarea","id":"item_2_description","label":"Item 2 description","default":"Describe how your ideas became a clear purpose."},{"type":"text","id":"item_3_eyebrow","label":"Item 3 eyebrow","default":"Today"},{"type":"text","id":"item_3_title","label":"Item 3 title","default":"Made for meaningful moments"},{"type":"textarea","id":"item_3_description","label":"Item 3 description","default":"Highlight what makes your collection special today."},{"type":"text","id":"item_4_eyebrow","label":"Item 4 eyebrow","default":"Next"},{"type":"text","id":"item_4_title","label":"Item 4 title","default":"Looking ahead"},{"type":"textarea","id":"item_4_description","label":"Item 4 description","default":"Invite customers to follow along with what comes next."},{"type":"text","id":"item_5_eyebrow","label":"Item 5 eyebrow","default":"Beyond"},{"type":"text","id":"item_5_title","label":"Item 5 title","default":"The story continues"},{"type":"textarea","id":"item_5_description","label":"Item 5 description","default":"Close with a memorable final milestone or message."}],"presets":[{"name":"Scroll timeline"}],"tag":null,"class":"scroll-timeline-block"}{% endschema %}