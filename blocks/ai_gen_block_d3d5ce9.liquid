{% doc %}
  @prompt
    <section class="gift-guide-hero">
      {% if section.settings.image != blank %}
        <div class="gift-guide-hero__image">
          {{
            section.settings.image
            | image_url: width: 3840
            | image_tag:
              loading: 'eager',
              widths: '1200, 1800, 2400, 3000, 3840',
              sizes: '100vw'
          }}
        </div>
      {% endif %}
    
      <div class="gift-guide-hero__content">
        {% if section.settings.eyebrow != blank %}
          <div class="gift-guide-hero__eyebrow">
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}
    
        {% if section.settings.heading != blank %}
          <h1>{{ section.settings.heading }}</h1>
        {% endif %}
    
        {% if section.settings.description != blank %}
          <div class="gift-guide-hero__description">
            {{ section.settings.description }}
          </div>
        {% endif %}
    
        {% if section.settings.button_label != blank %}
          <a
            href="{{ section.settings.button_link }}"
            class="gift-guide-hero__button"
          >
            {{ section.settings.button_label }}
            <span>→</span>
          </a>
        {% endif %}
      </div>
    </section>
    
    <style>
      .gift-guide-hero {
        position: relative;
        width: 100%;
        min-height: 620px;
        overflow: hidden;
        background: #f8f8f5;
      }
    
      .gift-guide-hero__image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }
    
      .gift-guide-hero__image img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center;
      }
    
      .gift-guide-hero__content {
        position: relative;
        z-index: 2;
        min-height: 620px;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 60px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
      }
    
      .gift-guide-hero__eyebrow {
        font-size: 12px;
        line-height: 1.2;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 12px;
        color: #111;
      }
    
      .gift-guide-hero h1 {
        margin: 0 0 18px;
        max-width: 500px;
        font-size: clamp(42px, 5vw, 76px);
        line-height: 0.98;
        font-weight: 500;
        letter-spacing: -2px;
        color: #111;
      }
    
      .gift-guide-hero__description {
        max-width: 430px;
        margin-bottom: 28px;
        font-size: 13px;
        line-height: 1.55;
        color: #111;
      }
    
      .gift-guide-hero__button {
        display: inline-flex;
        align-items: center;
        gap: 18px;
        padding: 13px 22px;
        background: #111;
        color: #fff;
        text-decoration: none;
        font-size: 11px;
        line-height: 1;
        letter-spacing: 1px;
        text-transform: uppercase;
        transition: all .25s ease;
      }
    
      .gift-guide-hero__button span {
        transition: transform .25s ease;
      }
    
      .gift-guide-hero__button:hover {
        background: #333;
      }
    
      .gift-guide-hero__button:hover span {
        transform: translateX(5px);
      }
    
      @media screen and (max-width: 749px) {
        .gift-guide-hero {
          min-height: 520px;
        }
    
        .gift-guide-hero__content {
          min-height: 520px;
          padding: 40px 24px;
          justify-content: flex-end;
          padding-bottom: 55px;
        }
    
        .gift-guide-hero__image img {
          object-position: center;
        }
    
        .gift-guide-hero h1 {
          font-size: 42px;
          letter-spacing: -1px;
          margin-bottom: 14px;
        }
    
        .gift-guide-hero__description {
          max-width: 310px;
          font-size: 12px;
          margin-bottom: 22px;
        }
    
        .gift-guide-hero__button {
          padding: 12px 18px;
        }
      }
    </style>
    
    {% schema %}
    {
      "name": "Gift Guide Hero",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Hero image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Gift Guide"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The Gift Guide"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Discover the perfect gifts for everyone on your list. Find something special for every occasion.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ],
      "presets": [
        {
          "name": "Gift Guide Hero"
        }
      ]
    }
    {% endschema %}
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gift-guide-hero-{{ ai_gen_id }} {
    position: relative;
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-height: {{ block.settings.hero_height }}px;
    overflow: hidden;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-gift-guide-hero-{{ ai_gen_id }}__image,
  .ai-gift-guide-hero-{{ ai_gen_id }}__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ai-gift-guide-hero-{{ ai_gen_id }}__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_position }};
  }

  .ai-gift-guide-hero-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.text_color }};
    opacity: 0.35;
  }

  .ai-gift-guide-hero-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    max-width: 420px;
    max-height: 420px;
  }

  .ai-gift-guide-hero-{{ ai_gen_id }}__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    width: min(100%, 1200px);
    min-height: {{ block.settings.hero_height }}px;
    margin: 0 auto;
    padding: 48px 60px;
    background: linear-gradient(90deg, rgba(248, 248, 245, 0.92) 0%, rgba(248, 248, 245, 0.68) 42%, rgba(248, 248, 245, 0) 75%);
  }

  .ai-gift-guide-hero-{{ ai_gen_id }}__eyebrow {
    margin-bottom: 12px;
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .ai-gift-guide-hero-{{ ai_gen_id }}__heading {
    max-width: 500px;
    margin: 0 0 18px;
    color: inherit;
    font-size: clamp(42px, 5vw, 76px);
    line-height: 0.98;
    font-weight: 500;
    letter-spacing: -2px;
  }

  .ai-gift-guide-hero-{{ ai_gen_id }}__description {
    max-width: 430px;
    margin-bottom: 28px;
    font-size: 13px;
    line-height: 1.55;
  }

  .ai-gift-guide-hero-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 13px 22px;
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-size: 11px;
    line-height: 1;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .ai-gift-guide-hero-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  .ai-gift-guide-hero-{{ ai_gen_id }}__empty-state {
    position: absolute;
    bottom: 18px;
    left: 50%;
    z-index: 1;
    width: max-content;
    max-width: calc(100% - 32px);
    padding: 8px 12px;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.85);
    color: #555555;
    font-size: 12px;
  }

  @media screen and (max-width: 749px) {
    .ai-gift-guide-hero-{{ ai_gen_id }},
    .ai-gift-guide-hero-{{ ai_gen_id }}__content {
      min-height: {{ block.settings.mobile_height }}px;
    }

    .ai-gift-guide-hero-{{ ai_gen_id }}__content {
      justify-content: flex-end;
      padding: 40px 24px 55px;
      background: linear-gradient(0deg, rgba(248, 248, 245, 0.94) 0%, rgba(248, 248, 245, 0.72) 45%, rgba(248, 248, 245, 0) 82%);
    }

    .ai-gift-guide-hero-{{ ai_gen_id }}__heading {
      font-size: 42px;
      letter-spacing: -1px;
    }

    .ai-gift-guide-hero-{{ ai_gen_id }}__description {
      max-width: 310px;
      font-size: 12px;
    }
  }
{% endstyle %}

<div class="ai-gift-guide-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.image != blank %}
    <div class="ai-gift-guide-hero-{{ ai_gen_id }}__image">
      {{ block.settings.image | image_url: width: 3840 | image_tag: loading: 'eager', widths: '1200, 1800, 2400, 3000, 3840', sizes: '100vw', alt: block.settings.image.alt | escape }}
    </div>
  {% else %}
    <div class="ai-gift-guide-hero-{{ ai_gen_id }}__placeholder">
      {{ 'image' | placeholder_svg_tag }}
      <span class="ai-gift-guide-hero-{{ ai_gen_id }}__empty-state">Add a hero image in the block settings</span>
    </div>
  {% endif %}

  <div class="ai-gift-guide-hero-{{ ai_gen_id }}__content">
    {% if block.settings.eyebrow != blank %}
      <div class="ai-gift-guide-hero-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</div>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h2 class="ai-gift-guide-hero-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="ai-gift-guide-hero-{{ ai_gen_id }}__description">{{ block.settings.description }}</div>
    {% endif %}

    {% if block.settings.button_label != blank and block.settings.button_link != blank %}
      <a href="{{ block.settings.button_link }}" class="ai-gift-guide-hero-{{ ai_gen_id }}__button">
        {{ block.settings.button_label | escape }}
        <span aria-hidden="true">→</span>
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Gift guide hero",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Gift guide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The gift guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover the perfect gifts for everyone on your list.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Desktop height",
      "min": 400,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 620
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 400,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F8F8F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "focus_color",
      "label": "Focus outline",
      "default": "#334FB4"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Gift guide hero"
    }
  ],
  "tag": null,
  "class": "gift-guide-hero-block"
}
{% endschema %}