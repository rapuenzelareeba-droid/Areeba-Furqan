{% comment %}
  EcomExperts Hiring Test - Gift Guide Banner
  Custom-built section; no Dawn banner component used.
{% endcomment %}

<section id="GiftGuideBanner-{{ section.id }}" class="gg-banner">
  <div class="gg-banner__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', alt: section.settings.heading | escape }}
    {% endif %}
  </div>

  <div class="gg-banner__overlay"></div>
  <div class="gg-banner__content gg-banner__content--{{ section.settings.alignment }}">
    {% if section.settings.eyebrow != blank %}<p class="gg-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h1>{{ section.settings.heading | escape }}</h1>{% endif %}
    {% if section.settings.text != blank %}<div class="gg-banner__text">{{ section.settings.text }}</div>{% endif %}
    {% if section.settings.button_label != blank %}
      <a class="gg-banner__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        <span>{{ section.settings.button_label | escape }}</span>
      </a>
    {% endif %}
  </div>
</section>

<style>
  #GiftGuideBanner-{{ section.id }} {
    position: relative;
    min-height: {{ section.settings.desktop_height }}px;
    overflow: hidden;
    background: #f7f5f0;
    display: grid;
    place-items: center;
  }
  #GiftGuideBanner-{{ section.id }} .gg-banner__media,
  #GiftGuideBanner-{{ section.id }} .gg-banner__overlay {
    position: absolute;
    inset: 0;
  }
  #GiftGuideBanner-{{ section.id }} .gg-banner__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  #GiftGuideBanner-{{ section.id }} .gg-banner__overlay { background: rgba(255,255,255,.22); }
  #GiftGuideBanner-{{ section.id }} .gg-banner__content {
    position: relative;
    z-index: 2;
    width: min({{ section.settings.max_width }}px, calc(100% - 40px));
    padding: 50px 20px;
  }
  #GiftGuideBanner-{{ section.id }} .gg-banner__content--center { text-align: center; margin-inline: auto; }
  #GiftGuideBanner-{{ section.id }} .gg-banner__content--left { text-align: left; margin-right: auto; }
  #GiftGuideBanner-{{ section.id }} .gg-banner__content--right { text-align: right; margin-left: auto; }
  #GiftGuideBanner-{{ section.id }} .gg-banner__eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  #GiftGuideBanner-{{ section.id }} h1 {
    margin: 0;
    font-size: clamp(48px, 8vw, 112px);
    line-height: .92;
    letter-spacing: -.045em;
    font-weight: 700;
  }
  #GiftGuideBanner-{{ section.id }} .gg-banner__text {
    max-width: 620px;
    margin: 24px auto 0;
    font-size: clamp(15px, 1.6vw, 20px);
    line-height: 1.55;
  }
  #GiftGuideBanner-{{ section.id }} .gg-banner__content--left .gg-banner__text { margin-left: 0; }
  #GiftGuideBanner-{{ section.id }} .gg-banner__content--right .gg-banner__text { margin-left: auto; margin-right: 0; }
  #GiftGuideBanner-{{ section.id }} .gg-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 190px;
    min-height: 54px;
    margin-top: 30px;
    padding: 0 28px;
    background: #111;
    color: #fff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    transition: transform .25s ease, background .25s ease;
    animation: ggButtonPulse 2.4s ease-in-out infinite;
  }
  #GiftGuideBanner-{{ section.id }} .gg-banner__button:hover { transform: translateY(-3px); background: #333; }
  @keyframes ggButtonPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(17,17,17,0); }
    50% { box-shadow: 0 0 0 7px rgba(17,17,17,.08); }
  }
  @media (max-width: 749px) {
    #GiftGuideBanner-{{ section.id }} { min-height: {{ section.settings.mobile_height }}px; }
    #GiftGuideBanner-{{ section.id }} .gg-banner__content { width: calc(100% - 24px); padding: 36px 12px; }
    #GiftGuideBanner-{{ section.id }} h1 { font-size: clamp(44px, 15vw, 72px); }
    #GiftGuideBanner-{{ section.id }} .gg-banner__text { font-size: 15px; }
  }
</style>

{% schema %}
{
  "name": "Gift Guide Banner",
  "tag": "section",
  "class": "section-gift-guide-banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Gift Guide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Find something special for everyone on your list.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the guide" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "alignment", "label": "Content alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center" },
    { "type": "range", "id": "desktop_height", "label": "Desktop height", "min": 400, "max": 900, "step": 10, "default": 620, "unit": "px" },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 420, "max": 900, "step": 10, "default": 620, "unit": "px" },
    { "type": "range", "id": "max_width", "label": "Content max width", "min": 700, "max": 1400, "step": 20, "default": 1200, "unit": "px" }
  ],
  "presets": [{ "name": "Gift Guide Banner" }]
}
{% endschema %}
