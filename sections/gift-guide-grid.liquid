{% comment %}
  EcomExperts Hiring Test - Product Grid + Popup
  Six products are selected in the Shopify customizer.
  Product data and variants are rendered dynamically from Shopify.
  Vanilla JavaScript only.
{% endcomment %}

<section id="GiftGuideGrid-{{ section.id }}" class="gg-grid-section">
  <div class="gg-grid-wrap">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
    <div class="gg-grid" data-gg-grid>
      {% for block in section.blocks limit: 6 %}
        {% assign product = block.settings.product %}
        {% if product != blank %}
          <button type="button" class="gg-card" data-product-handle="{{ product.handle }}" {{ block.shopify_attributes }}>
            <span class="gg-card__image">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title | escape }}
              {% endif %}
            </span>
            <span class="gg-card__name">{{ product.title | escape }}</span>
            <span class="gg-card__price">{{ product.price | money }}</span>
          </button>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="gg-modal" data-gg-modal hidden>
    <div class="gg-modal__backdrop" data-gg-close></div>
    <div class="gg-modal__panel" role="dialog" aria-modal="true" aria-labelledby="GGTitle-{{ section.id }}">
      <button type="button" class="gg-modal__close" aria-label="Close" data-gg-close>×</button>
      <div class="gg-modal__image"><img data-gg-image src="" alt=""></div>
      <div class="gg-modal__details">
        <h3 id="GGTitle-{{ section.id }}" data-gg-title></h3>
        <div class="gg-modal__price" data-gg-price></div>
        <div class="gg-modal__description" data-gg-description></div>
        <form data-gg-form>
          <div data-gg-options></div>
          <p class="gg-error" data-gg-error hidden></p>
          <button class="gg-add" type="submit">ADD TO CART</button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  #GiftGuideGrid-{{ section.id }} { background:#fff; padding:60px 20px 90px; }
  #GiftGuideGrid-{{ section.id }} .gg-grid-wrap { max-width:{{ section.settings.max_width }}px; margin:0 auto; }
  #GiftGuideGrid-{{ section.id }} h2 { margin:0 0 34px; text-align:center; font-size:clamp(30px,4vw,48px); line-height:1; }
  #GiftGuideGrid-{{ section.id }} .gg-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; }
  #GiftGuideGrid-{{ section.id }} .gg-card { border:0; padding:0; background:#f3f1ec; text-align:left; cursor:pointer; color:#111; font:inherit; overflow:hidden; }
  #GiftGuideGrid-{{ section.id }} .gg-card__image { display:block; aspect-ratio:1/1; overflow:hidden; background:#eee; }
  #GiftGuideGrid-{{ section.id }} .gg-card__image img { width:100%; height:100%; display:block; object-fit:cover; transition:transform .35s ease; }
  #GiftGuideGrid-{{ section.id }} .gg-card:hover .gg-card__image img { transform:scale(1.04); }
  #GiftGuideGrid-{{ section.id }} .gg-card__name { display:block; padding:16px 16px 5px; font-weight:700; font-size:15px; }
  #GiftGuideGrid-{{ section.id }} .gg-card__price { display:block; padding:0 16px 18px; font-size:14px; }
  #GiftGuideGrid-{{ section.id }} .gg-modal[hidden] { display:none; }
  #GiftGuideGrid-{{ section.id }} .gg-modal { position:fixed; inset:0; z-index:9999; display:grid; place-items:center; padding:20px; }
  #GiftGuideGrid-{{ section.id }} .gg-modal__backdrop { position:absolute; inset:0; background:rgba(0,0,0,.58); }
  #GiftGuideGrid-{{ section.id }} .gg-modal__panel { position:relative; z-index:1; width:min(920px,100%); max-height:90vh; overflow:auto; background:#fff; display:grid; grid-template-columns:1fr 1fr; }
  #GiftGuideGrid-{{ section.id }} .gg-modal__close { position:absolute; top:12px; right:14px; z-index:2; border:0; background:#fff; width:38px; height:38px; border-radius:50%; font-size:27px; cursor:pointer; line-height:1; }
  #GiftGuideGrid-{{ section.id }} .gg-modal__image { background:#f1f0ec; min-height:460px; }
  #GiftGuideGrid-{{ section.id }} .gg-modal__image img { width:100%; height:100%; min-height:460px; display:block; object-fit:cover; }
  #GiftGuideGrid-{{ section.id }} .gg-modal__details { padding:52px 42px 42px; display:flex; flex-direction:column; justify-content:center; }
  #GiftGuideGrid-{{ section.id }} .gg-modal__details h3 { margin:0 0 12px; font-size:34px; line-height:1.05; }
  #GiftGuideGrid-{{ section.id }} .gg-modal__price { font-size:18px; font-weight:700; margin-bottom:24px; }
  #GiftGuideGrid-{{ section.id }} .gg-modal__description { font-size:14px; line-height:1.65; margin-bottom:24px; }
  #GiftGuideGrid-{{ section.id }} .gg-option { margin:0 0 18px; }
  #GiftGuideGrid-{{ section.id }} .gg-option label { display:block; font-size:12px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; margin-bottom:8px; }
  #GiftGuideGrid-{{ section.id }} .gg-option select { width:100%; height:46px; border:1px solid #222; background:#fff; padding:0 12px; }
  #GiftGuideGrid-{{ section.id }} .gg-add { width:100%; min-height:52px; border:1px solid #111; background:#111; color:#fff; font-weight:700; letter-spacing:.1em; cursor:pointer; }
  #GiftGuideGrid-{{ section.id }} .gg-add:hover { background:#333; }
  #GiftGuideGrid-{{ section.id }} .gg-error { color:#b42318; font-size:13px; }
  @media (max-width:749px) {
    #GiftGuideGrid-{{ section.id }} { padding:42px 14px 60px; }
    #GiftGuideGrid-{{ section.id }} .gg-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
    #GiftGuideGrid-{{ section.id }} .gg-card__name { padding:11px 10px 4px; font-size:13px; }
    #GiftGuideGrid-{{ section.id }} .gg-card__price { padding:0 10px 12px; font-size:12px; }
    #GiftGuideGrid-{{ section.id }} .gg-modal { padding:10px; }
    #GiftGuideGrid-{{ section.id }} .gg-modal__panel { grid-template-columns:1fr; max-height:94vh; }
    #GiftGuideGrid-{{ section.id }} .gg-modal__image, #GiftGuideGrid-{{ section.id }} .gg-modal__image img { min-height:280px; height:280px; }
    #GiftGuideGrid-{{ section.id }} .gg-modal__details { padding:28px 22px 24px; }
    #GiftGuideGrid-{{ section.id }} .gg-modal__details h3 { font-size:28px; }
  }
</style>

<script>
(() => {
  const root = document.getElementById('GiftGuideGrid-{{ section.id }}');
  if (!root || root.dataset.ready === 'true') return;
  root.dataset.ready = 'true';

  const modal = root.querySelector('[data-gg-modal]');
  const image = root.querySelector('[data-gg-image]');
  const title = root.querySelector('[data-gg-title]');
  const price = root.querySelector('[data-gg-price]');
  const description = root.querySelector('[data-gg-description]');
  const options = root.querySelector('[data-gg-options]');
  const form = root.querySelector('[data-gg-form]');
  const error = root.querySelector('[data-gg-error]');
  let activeProduct = null;

  const money = (cents, currency) => {
    try { return new Intl.NumberFormat('{{ localization.language.iso_code | default: 'en' }}', { style:'currency', currency: currency || 'USD' }).format(cents / 100); }
    catch (_) { return (cents / 100).toFixed(2); }
  };

  const open = async (handle) => {
    error.hidden = true;
    options.innerHTML = '';
    try {
      const response = await fetch(`/products/${handle}.js`);
      if (!response.ok) throw new Error('Product unavailable');
      activeProduct = await response.json();
      image.src = activeProduct.featured_image || (activeProduct.images && activeProduct.images[0]) || '';
      image.alt = activeProduct.title;
      title.textContent = activeProduct.title;
      price.textContent = money(activeProduct.price, activeProduct.currency);
      description.innerHTML = activeProduct.description || '';

      activeProduct.options.forEach((option, index) => {
        if (option.values.length <= 1) return;
        const wrap = document.createElement('div');
        wrap.className = 'gg-option';
        const label = document.createElement('label');
        label.textContent = option.name;
        label.htmlFor = `gg-${index}-${root.id}`;
        const select = document.createElement('select');
        select.id = label.htmlFor;
        select.dataset.optionIndex = index;
        option.values.forEach(value => {
          const item = document.createElement('option');
          item.value = value;
          item.textContent = value;
          select.appendChild(item);
        });
        wrap.append(label, select);
        options.appendChild(wrap);
      });
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    } catch (err) {
      error.textContent = 'Unable to load this product.';
      error.hidden = false;
    }
  };

  const close = () => { modal.hidden = true; document.body.style.overflow = ''; };

  root.querySelectorAll('.gg-card').forEach(card => card.addEventListener('click', () => open(card.dataset.productHandle)));
  root.querySelectorAll('[data-gg-close]').forEach(el => el.addEventListener('click', close));
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && !modal.hidden) close(); });

  form.addEventListener('submit', async event => {
    event.preventDefault();
    if (!activeProduct) return;
    error.hidden = true;
    const selected = activeProduct.options.map((option, index) => {
      const select = options.querySelector(`[data-option-index="${index}"]`);
      return select ? select.value : option.values[0];
    });
    const variant = activeProduct.variants.find(item => item.options.every((value, index) => value === selected[index]));
    if (!variant) {
      error.textContent = 'Please select valid options.';
      error.hidden = false;
      return;
    }

    const items = [{ id: variant.id, quantity: 1 }];
    const shouldAddJacket = selected.some(value => value.toLowerCase() === 'black') && selected.some(value => value.toLowerCase() === 'medium');

    if (shouldAddJacket) {
      try {
        const jacketResponse = await fetch('/products/soft-winter-jacket.js');
        if (jacketResponse.ok) {
          const jacket = await jacketResponse.json();
          const jacketVariant = jacket.variants.find(v => v.available) || jacket.variants[0];
          if (jacketVariant && jacketVariant.id !== variant.id) items.push({ id: jacketVariant.id, quantity: 1 });
        }
      } catch (_) {}
    }

    try {
      const cartResponse = await fetch('/cart/add.js', {
        method:'POST', headers:{'Content-Type':'application/json','Accept':'application/json'},
        body:JSON.stringify({ items })
      });
      if (!cartResponse.ok) throw new Error('Cart error');
      window.location.href = '/cart';
    } catch (_) {
      error.textContent = 'Could not add the product to cart.';
      error.hidden = false;
    }
  });
})();
</script>

{% schema %}
{
  "name": "Gift Guide Grid",
  "tag": "section",
  "class": "section-gift-guide-grid",
  "max_blocks": 6,
  "blocks": [
    { "type": "product", "name": "Product", "settings": [{ "type": "product", "id": "product", "label": "Product" }] }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gift Guide" },
    { "type": "range", "id": "max_width", "label": "Grid max width", "min": 800, "max": 1500, "step": 20, "default": 1180, "unit": "px" }
  ],
  "presets": [
    { "name": "Gift Guide Grid", "blocks": [{"type":"product"},{"type":"product"},{"type":"product"},{"type":"product"},{"type":"product"},{"type":"product"}] }
  ]
}
{% endschema %}